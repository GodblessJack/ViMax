{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/admin/ViMax/web/.claude/hooks/heartbeat-check.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/admin/ViMax/web/.claude/hooks/circuit-breaker.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/admin/ViMax/web/.claude/hooks/maker-checker.sh",
            "async": true,
            "asyncRewake": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/admin/ViMax/web/.claude/hooks/precompact-checkpoint.sh"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/admin/ViMax/web/.claude/hooks/learning-capture.sh"
          }
        ]
      }
    ]
  }
}
